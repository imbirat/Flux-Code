{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flux Code",
  "mainBinaryName": "Flux",
  "version": "0.1.0",
  "identifier": "com.fluxcode.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm.cmd run dev",
    "beforeBuildCommand": "npm.cmd run build"
  },
  "app": {
    "windows": [
      {
        "title": "Flux Code",
        "label": "main",
        "width": 1320,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 660,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http://localhost:* http://127.0.0.1:*; media-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src https: http:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
